# ── Environment Variables das funcoes serverless (/api/*) ──────────────
# Sao as variaveis do projeto na VERCEL (Project -> Settings ->
# Environment Variables). NUNCA commitar os valores reais: o .env ja esta
# no .gitignore. O front (public/) nao usa nenhuma delas.
#
# TESTE LOCAL (sem Vercel): copie este arquivo para `.env` na raiz do
# repositorio e preencha SO o MP_ACCESS_TOKEN. Depois:
#   npm run point:check -- --gravar --colocar-pdv   (acha e grava o terminal)
#   npm run api:dev                                 (API em http://127.0.0.1:3001)
# Passo a passo completo: README, secao "Conectar hoje".

# ── Mercado Pago (Point) ───────────────────────────────────────────────
# Painel do desenvolvedor -> Suas integracoes -> (sua aplicacao) ->
# Credenciais de producao. Tem que ser a MESMA conta dona da maquininha.
MP_ACCESS_TOKEN=APP_USR-0000000000000000-000000-00000000000000000000000000000000-000000000

# Id da maquininha que vai receber as cobrancas, EXATAMENTE como o Mercado
# Pago devolve (formato TIPO__SERIAL, ex.: NEWLAND_N950__N950NCB801293324).
# Nao sabe qual e? Rode `npm run point:check -- --gravar` (grava aqui sozinho
# se a conta tiver um terminal so) ou, em Configuracoes -> Maquininha,
# "Testar conexao": o sistema lista os terminais da conta com o id de cada um.
MP_POINT_TERMINAL_ID=

# Painel -> Webhooks -> "Assinatura secreta" (valida o x-signature das
# notificacoes). Recomendado em producao; sem ela o webhook so avisa no log.
MP_WEBHOOK_SECRET=

# ── Firebase Admin (as funcoes leem/gravam no Firestore) ───────────────
# Service account do projeto flora-5754a (o MESMO da loja e do site).
# Console Firebase -> Configuracoes do projeto -> Contas de servico ->
# "Gerar nova chave privada". Aceita o JSON cru OU em base64:
#   PowerShell:  [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))
#   Linux/Mac:   base64 -w0 service-account.json
# No TESTE LOCAL pode deixar vazio: vale o serviceAccount.json na raiz do
# repositorio (o mesmo dos scripts Python) ou GOOGLE_APPLICATION_CREDENTIALS.
FIREBASE_SERVICE_ACCOUNT=

# ── CORS ───────────────────────────────────────────────────────────────
# Origens do FRONT que podem chamar /api (separadas por virgula). So
# importa se o front ficar num dominio diferente do da API (ex.: front no
# Firebase Hosting, API na Vercel). Padrao:
#   https://flora-5754a-interno.web.app, https://flora-5754a-interno.firebaseapp.com,
#   http://localhost:5173
# Se preencher, esta lista SUBSTITUI o padrao. No teste local (npm run
# api:dev) o sistema em http://localhost:5173 e liberado sozinho, mesmo
# preenchida; outra porta local precisa entrar aqui.
CORS_ORIGINS=

# ── ImageKit (fotos de produto — tela Produtos) ──────────────────────────
# MESMA conta e MESMOS valores das env vars do site (painel ImageKit ->
# Developer options -> API keys). A chave PRIVADA fica só aqui no servidor:
# /api/imagekit-auth assina o envio e só responde para admin. Sem estas três,
# a tela Produtos volta a salvar a foto em base64 dentro do produto (modo
# antigo, pesado para o site).
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
