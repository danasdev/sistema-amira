rules_version = '2';

// =============================================================================
//  REGRAS CANONICAS DO PROJETO  flora-5754a
//  Este arquivo cobre O SITE (Flora/Amira) E O SISTEMA INTERNO (PDV/caixa/
//  comissoes). Os dois compartilham o mesmo Firestore.
//
//  >>> ESTA E A UNICA COPIA QUE PODE SER PUBLICADA <<<
//  Deploy sempre a partir deste repo:
//      firebase deploy --only firestore:rules,firestore:indexes
//
//  HISTORICO: em 2026-09-10 e de novo em 2026-09-12 um deploy feito a partir
//  do repo do SITE (~/Documentos/Amira) publicou uma versao SEM a secao do
//  sistema interno -> `contadores/caixa/vendas/comissoes/indicadores` e o
//  acesso de VENDEDOR a `pedidos`/`usuarios` cairam no bloqueio padrao
//  (paginas do sistema interno carregavam mas ficavam vazias/permission-
//  denied pra quem loga como vendedor). Cada vez que o site evolui as
//  proprias regras, alguem precisa reaplicar as mudancas AQUI, na secao do
//  sistema interno, antes de publicar — nunca publicar direto do repo do
//  site sem antes conferir contra este arquivo. Esta versao re-mescla a
//  secao do sistema sobre a base ATUAL do site (metodo de pagamento
//  `mercadopago`, `atacadoLigado()`, cancelamento pelo dono do pedido,
//  `pedidos.observacoes`, `avaliacoes`, validacao mais estrita de
//  `carrinhos` e `usuarios/dados`).
//
//  2026-09-13: reconciliado de novo — uma copia trazida do repo do site
//  ainda tinha o campo antigo `estoqueVarejo`/`estoqueAtacado` em
//  `produtos` (revertido aqui, o correto e o pool unico `estoque` — ver
//  PR de unificacao de estoque) mas trouxe uma coisa nova e legitima que
//  faltava aqui: `avaliacoesLoja/{docId}` (avaliacao da LOJA via QR code
//  do balcao fisico, sem login — ver admin/avaliacoes-loja.html). Ao
//  reconciliar uma copia trazida de la, sempre comparar campo por campo
//  com o que ja existe aqui antes de aceitar — nao é só "pegar tudo".
//
//  2026-10-08: `configuracoes/sistema` e `/indicadores` deixaram de ser
//  publicos (so staff le). Mesma mudanca copiada para o repo do site, que
//  agora guarda uma copia IDENTICA deste arquivo.
//
//  2026-10-08 (2): nova colecao `custos` (preco de custo, so admin).
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────
    function estaLogado() {
      return request.auth != null;
    }

    function ehDono(uid) {
      return estaLogado() && request.auth.uid == uid;
    }

    function emailVerificado() {
      return estaLogado() && request.auth.token.email_verified == true;
    }

    function temPerfil() {
      return estaLogado() &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function perfilData() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function ehAdmin() {
      return temPerfil() && perfilData().role == "admin";
    }

    // Vendedor do SISTEMA interno (loja fisica). Precisa estar ativo.
    function ehVendedor() {
      return temPerfil() &&
        perfilData().role == "vendedor" &&
        perfilData().get("ativo", false) == true;
    }

    // Funcionario da loja: admin (sempre) ou vendedor ativo.
    function ehStaff() {
      return ehAdmin() || ehVendedor();
    }

    function ehRevendedorAprovado() {
      return estaLogado() &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
        (perfilData().get("statusRevendedor", "") == "aprovado" ||
         perfilData().role == "admin");
    }

    // Modo atacado ligado? Sem o campo (ou sem o documento), o padrão é
    // LIGADO — o admin desliga em configuracoes/atacado.ativo.
    function atacadoLigado() {
      return !exists(/databases/$(database)/documents/configuracoes/atacado) ||
        get(/databases/$(database)/documents/configuracoes/atacado).data.get("ativo", true) == true;
    }

    // ── usuarios/{uid} ───────────────────────────────────────────────────
    // Cada pessoa só lê/edita o próprio perfil. Admin pode ler todos
    // (necessário para o painel administrativo), mas ninguém pode escrever
    // o campo "role" de si mesmo — isso evita que um cliente se promova a
    // admin editando o próprio documento.
    //
    // O perfil SÓ pode ser criado depois do e-mail estar verificado
    // (request.auth.token.email_verified). Isso impede que um script em
    // loop crie contas fantasma com documento no banco: sem clicar no link
    // de verificação, nada é gravado no Firestore. Contas Google já chegam
    // com email_verified == true.
    //
    // "statusRevendedor" nasce como "pendente" e só o admin muda para
    // "aprovado"/"rejeitado". O próprio usuário pode SOLICITAR revenda
    // (definir "pendente") a qualquer momento, desde que não esteja
    // mexendo num status já "aprovado" — isso suporta a troca de tipo de
    // conta sem criar conta nova (cliente → revendedor pendente).
    //
    // ALLOWLIST DE CHAVES (A2): tanto no create quanto no update do dono,
    // só os campos abaixo são aceitos. Isso impede o usuário de gravar
    // campos arbitrários / blobs gigantes no próprio perfil (abuso de
    // cota) ou de forjar dados que o painel admin exibe (ex.: selo MEI).
    // O tamanho das strings livres também é limitado.
    //
    // "ativo"/"comissao" sao campos do SISTEMA INTERNO — entram na
    // allowlist porque o documento e o mesmo: sem eles, um vendedor que
    // tambem e cliente nao conseguia salvar o proprio perfil na loja (o
    // hasOnly() reprovava so por ter esses campos ja gravados no doc,
    // mesmo sem o dono estar mexendo neles). Quem PODE mudar o VALOR deles
    // e so o admin — o update do dono trava isso abaixo (compara valor
    // antigo == novo).
    //
    // O SISTEMA interno cria contas de equipe (role "vendedor"/"admin")
    // pela instância primária já logada como admin — coberto pelo branch
    // `allow create: if ehAdmin()`.
    function chavesUsuarioPermitidas() {
      return ['nome', 'email', 'role', 'tipoConta', 'telefone', 'dataNascimento',
        'fotoURL', 'aceiteTermos', 'aceiteMarketing', 'consentimentoEm',
        'consentimentoVersao', 'criadoEm', 'atualizadoEm',
        'cnpj', 'razaoSocial', 'provavelMEI', 'porteEmpresa', 'statusRevendedor',
        'ativo', 'comissao'];
    }
    function stringsUsuarioNoLimite(d) {
      return (!('nome' in d) || (d.nome is string && d.nome.size() <= 120)) &&
        (!('telefone' in d) || (d.telefone is string && d.telefone.size() <= 20)) &&
        (!('dataNascimento' in d) || (d.dataNascimento is string && d.dataNascimento.size() <= 10)) &&
        (!('fotoURL' in d) || (d.fotoURL is string && d.fotoURL.size() <= 500)) &&
        (!('cnpj' in d) || (d.cnpj is string && d.cnpj.size() <= 18)) &&
        (!('razaoSocial' in d) || (d.razaoSocial is string && d.razaoSocial.size() <= 200)) &&
        (!('consentimentoVersao' in d) || (d.consentimentoVersao is string && d.consentimentoVersao.size() <= 20));
    }
    match /usuarios/{uid} {
      // Vendedor le perfil de clientes pra conferir nome/telefone na tela de
      // Pedidos (confirmacao de retirada/entrega) — mesmo nivel de confianca
      // ja dado a ele em produtos/pedidos.
      allow read: if ehDono(uid) || ehAdmin() || ehVendedor();

      // Cliente do site cria o próprio perfil.
      allow create: if ehDono(uid) &&
        emailVerificado() &&
        request.resource.data.keys().hasOnly(chavesUsuarioPermitidas()) &&
        request.resource.data.keys().hasAll(['nome', 'email', 'role', 'tipoConta',
          'telefone', 'dataNascimento', 'aceiteTermos', 'aceiteMarketing',
          'consentimentoEm', 'consentimentoVersao', 'criadoEm']) &&
        request.resource.data.role == "cliente" &&
        request.resource.data.aceiteTermos == true &&
        request.resource.data.aceiteMarketing is bool &&
        request.resource.data.consentimentoEm == request.time &&
        stringsUsuarioNoLimite(request.resource.data) &&
        (!("statusRevendedor" in request.resource.data) ||
          request.resource.data.statusRevendedor == "pendente");

      // Admin cria conta de equipe do SISTEMA (vendedor/admin). O uid é o
      // do Auth recém-criado (instância secundária), gravado pelo admin
      // logado.
      allow create: if ehAdmin() &&
        request.resource.data.role in ['vendedor', 'admin'];

      // Cliente do site edita o próprio perfil (allowlist, não mexe em role
      // nem se auto-aprova como revendedor). "ativo"/"comissao" (sistema
      // interno) so podem ser CARREGADOS, nunca mudados por aqui — senao um
      // vendedor se reativaria sozinho ou inventaria a propria comissao.
      allow update: if ehDono(uid) &&
        request.resource.data.keys().hasOnly(chavesUsuarioPermitidas()) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.get('ativo', true) == resource.data.get('ativo', true) &&
        request.resource.data.get('comissao', {}) == resource.data.get('comissao', {}) &&
        request.resource.data.get("aceiteTermos", true) == true &&
        stringsUsuarioNoLimite(request.resource.data) &&
        (
          // ou não mexe no status de revendedor…
          request.resource.data.get("statusRevendedor", "") ==
            resource.data.get("statusRevendedor", "") ||
          // …ou está solicitando revenda ("pendente"), o que é permitido
          // desde que o status atual não seja "aprovado" (um aprovado não
          // pode se "re-aprovar" nem resetar o próprio histórico).
          (request.resource.data.get("statusRevendedor", "") == "pendente" &&
            resource.data.get("statusRevendedor", "") != "aprovado")
        );

      // Admin edita/gerencia qualquer perfil (inclui ativo/comissao/role de
      // equipe do sistema).
      allow update: if ehAdmin();
      allow delete: if ehAdmin();
    }

    // ── usuarios/{uid}/dados/{docId} ──────────────────────────────────────
    // Subcoleção com dados extras do perfil (ex: endereço salvo). Mesma
    // regra de dono do documento pai: só o próprio usuário ou admin acessam.
    // ALLOWLIST: sem ela, "write: if ehDono(uid)" deixava qualquer pessoa
    // logada encher a própria subcoleção com documentos de 1 MB — não é
    // roubo de dado, é abuso de cota (a conta é da loja). Campo novo aqui
    // exige atualizar esta lista.
    function chavesEnderecoPermitidas() {
      return ['cep', 'endereco', 'bairro', 'cidadeUf', 'complemento', 'atualizadoEm'];
    }
    match /usuarios/{uid}/dados/{docId} {
      allow read: if ehDono(uid) || ehAdmin();
      allow write: if ehAdmin() ||
        (ehDono(uid) &&
          request.resource.data.keys().hasOnly(chavesEnderecoPermitidas()) &&
          (!('cep' in request.resource.data) ||
            (request.resource.data.cep is string && request.resource.data.cep.size() <= 12)) &&
          (!('endereco' in request.resource.data) ||
            (request.resource.data.endereco is string && request.resource.data.endereco.size() <= 300)) &&
          (!('bairro' in request.resource.data) ||
            (request.resource.data.bairro is string && request.resource.data.bairro.size() <= 120)) &&
          (!('cidadeUf' in request.resource.data) ||
            (request.resource.data.cidadeUf is string && request.resource.data.cidadeUf.size() <= 120)) &&
          (!('complemento' in request.resource.data) ||
            (request.resource.data.complemento is string && request.resource.data.complemento.size() <= 200)));
      allow delete: if ehDono(uid) || ehAdmin();
    }

    // ── produtos/{produtoId} ─────────────────────────────────────────────
    // Qualquer pessoa (logada ou não) pode VER o catálogo.
    // Só admin cria/edita/remove — MENOS a baixa de estoque no PDV: um
    // vendedor ativo pode alterar SOMENTE o campo de estoque (a venda em
    // si vai para a coleção `vendas`). Estoque e um so pool compartilhado
    // entre varejo e atacado (nao ha mais estoqueVarejo/estoqueAtacado
    // separados) — so o preco continua tendo dois valores.
    match /produtos/{produtoId} {
      allow read: if true;
      allow create, delete: if ehAdmin();
      allow update: if ehAdmin()
        || (ehVendedor()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['estoque', 'atualizadoEm']));
    }

    // ── camadas/{camadaId} ──────────────────────────────────────────────
    // Substitui a antiga coleção "categorias". Alimenta a navegação
    // inteira da loja (navbar, menu sanduíche, rodapé, "Nossas
    // categorias" e o painel de filtros do catálogo) — um documento
    // torto quebra o menu de todo mundo, então além de exigir admin a
    // regra valida o SHAPE. Limitação conhecida (igual a pedidos.itens):
    // o conteúdo de cada elemento de "opcoes" não é validável em rules
    // sem loop — como só o admin escreve, o risco é erro de digitação,
    // não abuso.
    match /camadas/{camadaId} {
      allow read: if true;
      allow create, update: if ehAdmin() &&
        request.resource.data.keys().hasOnly(['nome', 'slug', 'ordem', 'opcoes', 'criadoEm']) &&
        request.resource.data.keys().hasAll(['nome', 'slug', 'ordem', 'opcoes', 'criadoEm']) &&
        request.resource.data.nome is string &&
        request.resource.data.nome.size() >= 1 &&
        request.resource.data.nome.size() <= 60 &&
        request.resource.data.slug is string &&
        request.resource.data.slug.size() >= 1 &&
        request.resource.data.slug.size() <= 60 &&
        request.resource.data.ordem is int &&
        request.resource.data.ordem >= 1 &&
        request.resource.data.ordem <= 50 &&
        request.resource.data.opcoes is list &&
        request.resource.data.opcoes.size() <= 30;
      allow delete: if ehAdmin();
    }

    // ── configuracoes/{docId} ────────────────────────────────────────────
    // Textos e ajustes globais da loja (ex: mínimo de atacado por
    // carrinho, dados de pagamento PIX, imagens do carrossel da home) E
    // config do sistema interno (configuracoes/sistema, /indicadores).
    // Os da loja são públicos para leitura (a vitrine lê sem login). Os do
    // sistema interno NÃO: `sistema` tem CNPJ, comissão e formas de
    // pagamento, `indicadores` o percentual pago aos divulgadores — antes
    // qualquer pessoa lia pela API pública. Só a equipe (admin + vendedor
    // ativo) lê esses dois; no sistema interno toda página que os lê passa
    // antes por requireAuth(). Só admin edita qualquer um.
    // ⚠️ Por isso a coleção não pode ser LISTADA sem login (a regra vale
    // por documento) — o site só lê documentos pelo id.
    match /configuracoes/{docId} {
      allow read: if !(docId in ['sistema', 'indicadores']) || ehStaff();
      allow write: if ehAdmin();
    }

    // ── carrinhos/{uid} ──────────────────────────────────────────────────
    // O carrinho é privado: só o próprio dono lê/escreve o seu. O conteúdo
    // do carrinho NÃO é fonte de verdade de preço — no checkout, o total é
    // recalculado no cliente a partir da coleção "produtos" (que só o
    // admin escreve) e o pedido gravado não carrega valor monetário.
    // Mesma preocupação de cota da subcoleção "dados": o documento só
    // pode ter a chave "itens", e "itens" é uma lista curta. O SHAPE de
    // cada item não é validável em rules (sem loops) — mesma limitação
    // conhecida de pedidos.itens —, mas o carrinho não é fonte de verdade
    // de preço: o checkout recalcula tudo a partir de "produtos".
    match /carrinhos/{uid} {
      allow read: if ehDono(uid);
      allow write: if ehDono(uid) &&
        request.resource.data.keys().hasOnly(['itens']) &&
        request.resource.data.itens is list &&
        request.resource.data.itens.size() <= 50;
      allow delete: if ehDono(uid);
    }

    // ── pedidos/{pedidoId} ───────────────────────────────────────────────
    // SEM Cloud Functions (plano Spark/custo zero), o pedido é criado pelo
    // cliente — mas o documento NÃO PODE conter nenhum valor monetário:
    // a allowlist de chaves abaixo rejeita qualquer campo de preço/total.
    // Cada item guarda só {produtoId, quantidade, modo}; preço, desconto,
    // frete e total são DERIVADOS da coleção "produtos" (que só o admin
    // escreve) na hora de exibir (checkout, confirmação e painel admin).
    // Risco residual (ver docs/PLANO_PRODUCAO_2026-09.md, Apêndice A): o
    // shape de cada elemento de "itens" não é validável em rules (sem
    // loops). A função /api/pagamento recalcula o total no servidor antes
    // de cobrar; no PIX manual, a conferência humana barra adulteração.
    //
    // `ref`/`refEm` (opcionais) = código do indicador do link ?ref= do
    // site, capturado no navegador do cliente ate a compra, para a
    // apuração de comissão de indicação (feita depois derivando totais de
    // `produtos`). Tamanho <=24 porque indicadores.js trunca o codigo
    // nesse tamanho antes de gerar o link.
    //
    // `observacoes` (opcional) = nota livre do cliente pra loja. String
    // curta como as demais — o texto em si não é validado além do
    // tamanho, é lido por humano (o admin), não interpretado por código.
    match /pedidos/{pedidoId} {
      allow read: if estaLogado() &&
        (resource.data.uidComprador == request.auth.uid || ehAdmin() || ehVendedor());
      allow create: if estaLogado() &&
        emailVerificado() &&
        request.resource.data.keys().hasOnly(['uidComprador', 'itens', 'temItemAtacado', 'modoEntrega', 'endereco', 'status', 'pagamento', 'criadoEm', 'ref', 'refEm', 'observacoes']) &&
        request.resource.data.keys().hasAll(['uidComprador', 'itens', 'temItemAtacado', 'modoEntrega', 'endereco', 'status', 'pagamento', 'criadoEm']) &&
        request.resource.data.uidComprador == request.auth.uid &&
        request.resource.data.itens is list &&
        request.resource.data.itens.size() >= 1 &&
        request.resource.data.itens.size() <= 30 &&
        request.resource.data.temItemAtacado is bool &&
        (request.resource.data.temItemAtacado == false ||
          (ehRevendedorAprovado() && atacadoLigado())) &&
        request.resource.data.modoEntrega in ['entrega', 'retirada'] &&
        (
          (request.resource.data.modoEntrega == 'retirada' &&
            request.resource.data.endereco == null) ||
          (request.resource.data.modoEntrega == 'entrega' &&
            request.resource.data.endereco is map &&
            request.resource.data.endereco.keys().hasOnly(['cep', 'endereco', 'bairro']) &&
            request.resource.data.endereco.keys().hasAll(['cep', 'endereco', 'bairro']) &&
            request.resource.data.endereco.cep is string &&
            request.resource.data.endereco.cep.size() >= 8 &&
            request.resource.data.endereco.cep.size() <= 12 &&
            request.resource.data.endereco.endereco is string &&
            request.resource.data.endereco.endereco.size() >= 1 &&
            request.resource.data.endereco.endereco.size() <= 300 &&
            request.resource.data.endereco.bairro is string &&
            request.resource.data.endereco.bairro.size() >= 1 &&
            request.resource.data.endereco.bairro.size() <= 120)
        ) &&
        request.resource.data.status == 'aguardando_pagamento' &&
        request.resource.data.pagamento is map &&
        request.resource.data.pagamento.keys().hasOnly(['metodo', 'status']) &&
        request.resource.data.pagamento.keys().hasAll(['metodo', 'status']) &&
        // O cliente cria com o método pretendido. Campos do provedor
        // (provedorId, total, etc.) são adicionados DEPOIS pela função
        // serverless via Admin SDK, que ignora estas regras.
        request.resource.data.pagamento.metodo in ['pix_whatsapp', 'mercadopago'] &&
        request.resource.data.pagamento.status == 'pendente' &&
        request.resource.data.criadoEm == request.time &&
        // ref/refEm só existem JUNTOS: refEm prova que foi gravado agora,
        // no mesmo create — não um valor antigo reusado.
        ((!('ref' in request.resource.data) && !('refEm' in request.resource.data)) ||
          (request.resource.data.ref is string &&
            request.resource.data.ref.size() >= 1 &&
            request.resource.data.ref.size() <= 24 &&
            request.resource.data.refEm == request.time)) &&
        (!('observacoes' in request.resource.data) ||
          (request.resource.data.observacoes is string &&
            request.resource.data.observacoes.size() >= 1 &&
            request.resource.data.observacoes.size() <= 500));

      // O admin escreve o que precisar. O VENDEDOR (painel interno, tela
      // Pedidos) só pode mexer no status e nos campos de controle de estoque
      // que a propria tela escreve — nao pode tocar em itens, endereco,
      // pagamento, etc. Tambem nao pode desfazer uma entrega ja confirmada
      // (entregue -> cancelado): isso vira estorno de uma venda ja espelhada
      // em `vendas` (canal 'site'), e so admin desfaz venda concluida — mesmo
      // criterio ja usado em `vendas`. O DONO só pode fazer uma coisa:
      // CANCELAR um pedido que ele mesmo abriu e nunca pagou. A regra é
      // deliberadamente estreita — só a chave "status" pode mudar, só para
      // 'cancelado', só saindo de 'aguardando_pagamento' e só enquanto o
      // provedor não aprovou. Depois de pago vira caso de estorno, não de
      // cancelamento, e aí é o admin quem resolve.
      allow update: if ehAdmin() ||
        (ehVendedor() &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'atualizadoEm', 'estoqueBaixado', 'estoqueBaixadoEm', 'estoqueDevolvidoEm']) &&
          request.resource.data.status in
            ['aguardando_pagamento', 'pago', 'preparando', 'enviado', 'entregue', 'cancelado'] &&
          !(resource.data.status == 'entregue' && request.resource.data.status == 'cancelado')) ||
        (estaLogado() &&
          resource.data.uidComprador == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
          request.resource.data.status == 'cancelado' &&
          resource.data.status == 'aguardando_pagamento' &&
          resource.data.pagamento.status != 'aprovado');

      allow delete: if ehAdmin();
    }

    // ── metricas/{docId} ─────────────────────────────────────────────────
    // Qualquer visitante pode registrar um evento de acesso, mas o shape é
    // validado aqui: só os campos da allowlist, com valores controlados e
    // strings curtas. Isso fecha a escrita pública ilimitada (billing/spam).
    // A proteção contra bots que respeitam o shape vem do App Check.
    match /metricas/{docId} {
      allow create: if
        request.resource.data.keys().hasOnly(['tipo', 'pagina', 'dispositivo', 'origem', 'criadoEm']) &&
        request.resource.data.keys().hasAll(['tipo', 'pagina', 'dispositivo', 'origem', 'criadoEm']) &&
        request.resource.data.tipo in ['pagina', 'produto'] &&
        request.resource.data.pagina is string &&
        request.resource.data.pagina.size() > 0 &&
        request.resource.data.pagina.size() <= 200 &&
        request.resource.data.dispositivo in ['mobile', 'tablet', 'desktop'] &&
        request.resource.data.origem is string &&
        request.resource.data.origem.size() > 0 &&
        request.resource.data.origem.size() <= 200 &&
        request.resource.data.criadoEm == request.time;
      allow read: if ehAdmin();
      allow update, delete: if ehAdmin();
    }

    // ── avaliacoes/{docId} ───────────────────────────────────────────────
    // Avaliação de produto por quem comprou.
    //
    // ⚠️ O QUE ESTA REGRA CONSEGUE E O QUE NÃO CONSEGUE GARANTIR:
    // ela confere que quem escreve é dono de um pedido PAGO — o cliente
    // manda o pedidoId e o get() abaixo checa. O que ela NÃO consegue é
    // conferir que aquele pedido contém ESTE produto: rules não fazem
    // laço sobre "itens" (mesma limitação já documentada em pedidos).
    //
    // Quem fecha essa brecha é a MODERAÇÃO: a avaliação nasce com
    // aprovada = false e só o admin publica. A loja lê apenas as
    // aprovadas. Sem isso, alguém com um pedido pago poderia avaliar
    // qualquer produto do catálogo.
    //
    // A checagem "o pedido contém este produto" existe, mas no cliente
    // (js/produto-detalhe.js) — ela é de INTERFACE, para não oferecer o
    // formulário a quem não pode usar. Não é o controle de segurança.
    function chavesAvaliacaoPermitidas() {
      return ['produtoId', 'pedidoId', 'uidAutor', 'nomeAutor', 'nota', 'texto',
        'aprovada', 'criadoEm'];
    }
    match /avaliacoes/{docId} {
      // Público vê só o que o admin publicou. O autor vê a própria,
      // mesmo pendente, para saber que foi enviada.
      allow read: if ehAdmin() ||
        resource.data.aprovada == true ||
        (estaLogado() && resource.data.uidAutor == request.auth.uid);

      allow create: if estaLogado() &&
        emailVerificado() &&
        request.resource.data.keys().hasOnly(chavesAvaliacaoPermitidas()) &&
        request.resource.data.keys().hasAll(['produtoId', 'pedidoId', 'uidAutor',
          'nomeAutor', 'nota', 'texto', 'aprovada', 'criadoEm']) &&
        request.resource.data.uidAutor == request.auth.uid &&
        // nasce SEMPRE pendente — publicar é ato do admin
        request.resource.data.aprovada == false &&
        request.resource.data.nota is int &&
        request.resource.data.nota >= 1 &&
        request.resource.data.nota <= 5 &&
        request.resource.data.texto is string &&
        request.resource.data.texto.size() <= 600 &&
        request.resource.data.nomeAutor is string &&
        request.resource.data.nomeAutor.size() <= 120 &&
        request.resource.data.produtoId is string &&
        request.resource.data.produtoId.size() <= 60 &&
        request.resource.data.criadoEm == request.time &&
        // o pedido citado existe, é de quem está escrevendo, e foi pago
        exists(/databases/$(database)/documents/pedidos/$(request.resource.data.pedidoId)) &&
        get(/databases/$(database)/documents/pedidos/$(request.resource.data.pedidoId)).data.uidComprador == request.auth.uid &&
        get(/databases/$(database)/documents/pedidos/$(request.resource.data.pedidoId)).data.status == 'pago';

      // Só o admin publica, despublica ou apaga. O autor não edita depois
      // de enviar: senão daria para trocar o texto DEPOIS de aprovado.
      allow update, delete: if ehAdmin();
    }

    // ── avaliacoesLoja/{docId} ────────────────────────────────────────────
    // Avaliação da LOJA (não de um produto) — pensada pro QR code no balcão
    // físico: QUALQUER pessoa avalia, sem estar logada e sem ter comprado
    // nada. Por isso não tem como amarrar num pedido pago, como faz
    // avaliacoes/{docId} logo acima. A única trava de verdade aqui é a
    // MODERAÇÃO: nasce aprovada = false, e só aparece publicamente depois
    // que o admin publica (ver admin/avaliacoes-loja.html). Sem isso,
    // qualquer um poderia colocar qualquer texto direto na home da loja.
    function chavesAvaliacaoLojaPermitidas() {
      return ['nome', 'nota', 'texto', 'aprovada', 'criadoEm', 'uidAutor'];
    }
    match /avaliacoesLoja/{docId} {
      allow read: if ehAdmin() || resource.data.aprovada == true;

      allow create: if
        request.resource.data.keys().hasOnly(chavesAvaliacaoLojaPermitidas()) &&
        request.resource.data.keys().hasAll(['nome', 'nota', 'texto', 'aprovada', 'criadoEm']) &&
        // nasce SEMPRE pendente — publicar é ato do admin
        request.resource.data.aprovada == false &&
        request.resource.data.nota is int &&
        request.resource.data.nota >= 1 &&
        request.resource.data.nota <= 5 &&
        request.resource.data.nome is string &&
        request.resource.data.nome.size() >= 1 &&
        request.resource.data.nome.size() <= 120 &&
        request.resource.data.texto is string &&
        request.resource.data.texto.size() <= 600 &&
        request.resource.data.criadoEm == request.time &&
        // uidAutor é OPCIONAL: só existe se a pessoa já estava logada ao
        // enviar, e nesse caso tem que ser o próprio uid — nunca em nome
        // de outra pessoa (mesmo padrão ausente-quando-vazio de ref/refEm
        // em pedidos e de observacoes).
        (!('uidAutor' in request.resource.data) ||
          (estaLogado() && request.resource.data.uidAutor == request.auth.uid));

      // Só o admin publica, despublica ou apaga — mesma régua de
      // avaliacoes/{docId}.
      allow update, delete: if ehAdmin();
    }

    // =========================================================================
    //  SISTEMA INTERNO (PDV / caixa / vendas / comissoes / indicadores / gastos)
    //  Colecoes usadas SO pelo app interno (sistema-amira). A loja NAO toca
    //  nestas — ver comentario em cada bloco. NUNCA remover esta secao num
    //  deploy feito a partir do repo do site: ver aviso no topo do arquivo.
    // =========================================================================

    // ── contadores/{doc} ────────────────────────────────────────────────
    // Numeracao sequencial das vendas da loja fisica.
    match /contadores/{doc} {
      allow read: if ehStaff();
      allow write: if ehStaff();
    }

    // ── caixa/{id} ──────────────────────────────────────────────────────
    // Caixa e UNICO/compartilhado pra loja toda, independente de qual conta
    // acessa — nao e "o caixa do vendedor X". Antes a regra so deixava um
    // vendedor ler/mexer no caixa que ELE MESMO abriu, entao dava pra duas
    // pessoas abrirem caixas "paralelos" sem perceber (a UI ja bloqueia via
    // caixaAberto() sem filtro de uid, mas a regra precisa acompanhar: sem
    // isso, um vendedor nao consegue nem VER o caixa que outra pessoa
    // abriu, e caia tudo em permission-denied). Qualquer staff ativo pode
    // ler, abrir (se nao houver nenhum aberto — a UI confere antes), lancar
    // movimento e fechar; so nao pode reescrever quem abriu originalmente
    // (aberto_por_uid nao muda depois de criado).
    match /caixa/{id} {
      allow read: if ehStaff();
      allow create: if ehStaff()
        && request.resource.data.aberto_por_uid == request.auth.uid
        && request.resource.data.status == 'aberto';
      allow update: if ehStaff()
        && request.resource.data.aberto_por_uid == resource.data.aberto_por_uid;
      allow delete: if false;
    }

    // ── vendas/{id} ────────────────────────────────────────────────────
    // Vendas da LOJA FISICA (canal 'loja') sao criadas pelo PDV, com
    // vendedor_uid == autor (entra na comissao, ver `comissoes`; a leitura
    // e liberada pra qualquer staff — nao so o autor — porque o caixa e
    // compartilhado: conferir o caixa exige somar as vendas de TODA a
    // equipe que vendeu enquanto ele esteve aberto, nao so as de quem esta
    // olhando agora). Vendas do canal 'site' sao um ESPELHO somente-leitura
    // de pedido do site confirmado como entregue (id determinístico
    // `site_{pedidoId}`, gravado pela tela Pedidos) — sem vendedor_uid (nao
    // gera comissao; `comissoes` so soma canal 'loja' de qualquer forma) e
    // sem numeracao sequencial propria (fica so no historico, identificado
    // pelo codigo do pedido). So admin desfaz uma venda concluida (ambos os
    // canais).
    match /vendas/{id} {
      allow read: if ehStaff();
      allow create: if ehAdmin()
        || (ehVendedor()
            && request.resource.data.canal == 'loja'
            && request.resource.data.vendedor_uid == request.auth.uid
            && request.resource.data.status == 'concluida')
        || (ehStaff()
            && request.resource.data.canal == 'site'
            && request.resource.data.vendedor_uid == null
            && request.resource.data.status == 'concluida');
      allow update: if ehAdmin();
      allow delete: if false;
    }

    // ── comissoes/{periodo}/vendedores/{uid} ───────────────────────────
    match /comissoes/{periodo} {
      allow read: if ehStaff();
      allow write: if ehAdmin();
      match /vendedores/{uid} {
        allow read: if ehAdmin() || (ehVendedor() && request.auth.uid == uid);
        allow write: if ehAdmin();
      }
    }

    // ── indicadores/{id} ──────────────────────────────────────────────
    // Divulgadores/indicadores do site (sem login proprio). `codigo` = valor
    // do link ?ref=. So o admin cadastra; a equipe pode consultar.
    match /indicadores/{id} {
      allow read: if ehStaff();
      allow create, update, delete: if ehAdmin();
    }

    // ── gastos/{id} ────────────────────────────────────────────────────
    // Despesas da loja (aluguel, fornecedor, salario, etc.) — SOLTAS por
    // data, nao amarradas a uma sessao de caixa (da pra lancar sem caixa
    // aberto). Caixa atribui um gasto a uma sessao filtrando por essa data;
    // o Painel soma por mes. So o admin cria/edita/exclui — deixar qualquer
    // vendedor lancar gasto livremente permitiria forjar uma despesa pra
    // reduzir o liquido reportado ao dono sem controle nenhum. Leitura e
    // liberada pra qualquer staff (o resumo aparece pra todo mundo no
    // Caixa, so a gestao completa e admin-only).
    function chavesGastoPermitidas() {
      return ['descricao', 'categoria', 'valor', 'data', 'observacoes',
        'criado_em', 'criado_por_uid', 'criado_por_nome', 'atualizado_em'];
    }
    match /gastos/{id} {
      allow read: if ehStaff();
      allow create: if ehAdmin() &&
        request.resource.data.keys().hasOnly(chavesGastoPermitidas()) &&
        request.resource.data.keys().hasAll(['descricao', 'valor', 'data', 'criado_em', 'criado_por_uid', 'criado_por_nome']) &&
        request.resource.data.descricao is string &&
        request.resource.data.descricao.size() >= 1 &&
        request.resource.data.descricao.size() <= 200 &&
        request.resource.data.valor is number &&
        request.resource.data.valor > 0 &&
        request.resource.data.data is timestamp &&
        request.resource.data.criado_por_uid == request.auth.uid &&
        (!('categoria' in request.resource.data) ||
          (request.resource.data.categoria is string && request.resource.data.categoria.size() <= 60)) &&
        (!('observacoes' in request.resource.data) ||
          (request.resource.data.observacoes is string && request.resource.data.observacoes.size() <= 500));
      allow update: if ehAdmin() &&
        request.resource.data.keys().hasOnly(chavesGastoPermitidas()) &&
        request.resource.data.descricao is string &&
        request.resource.data.descricao.size() >= 1 &&
        request.resource.data.descricao.size() <= 200 &&
        request.resource.data.valor is number &&
        request.resource.data.valor > 0 &&
        request.resource.data.data is timestamp;
      allow delete: if ehAdmin();
    }

    // ── custos/{doc} ─────────────────────────────────────────────────
    // Preço de CUSTO dos produtos (custos/produtos = { valores: {produtoId:
    // custo} }), usado no montante do estoque da tela Produtos. Fica fora de
    // `produtos` de propósito: aquela coleção é pública (o site lê sem
    // login) e o custo não pode vazar. Só admin lê e grava.
    match /custos/{doc} {
      allow read, write: if ehAdmin();
    }

    // ── integracoes/{doc=**} ─────────────────────────────────────────
    // Tokens/segredos de marketplace (fase futura) — so backend Admin SDK.
    match /integracoes/{doc=**} {
      allow read, write: if false;
    }

    // ── Bloqueio padrão ──────────────────────────────────────────────────
    // Cobre também "limites", o contador de requisições das funções
    // serverless (api/_lib/limite.js): o Admin SDK ignora estas regras, e
    // do cliente a coleção precisa ficar fechada — senão dava para zerar
    // o próprio contador.
    // Qualquer coleção não listada acima fica negada por padrão.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
